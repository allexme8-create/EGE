# Скопируйте в .env (или export) и поправьте под себя.
CALLBOT_DATA=/opt/callbot/data
CALLBOT_HOST=0.0.0.0
CALLBOT_PORT=8000

# Режим: demo (без модема) или modem (реальные звонки)
CALLBOT_MODE=modem

# Модем с SIM МегаФона
CALLBOT_MODEM_PORT=/dev/ttyUSB0

# USB-звуковая карта / гарнитура, подключённая к модему (arecord -l / aplay -l)
CALLBOT_AUDIO_PLAY=plughw:1,0
CALLBOT_AUDIO_REC=plughw:1,0

# Распознавание речи: auto|vosk|whispercpp|http|stub
CALLBOT_ASR=vosk
CALLBOT_VOSK_MODEL=/opt/callbot/data/models/vosk-model-small-ru-0.22
# CALLBOT_ASR_HTTP=http://127.0.0.1:9000

# Синтез речи: auto|piper|espeak|none
CALLBOT_TTS=piper
CALLBOT_PIPER_BIN=/usr/local/bin/piper
CALLBOT_PIPER_MODEL=/opt/callbot/data/models/ru_RU-irina-medium.onnx

# Basic-аутентификация (необязательно; включится, если задан пароль)
# CALLBOT_USER=admin
# CALLBOT_PASSWORD=change-me
